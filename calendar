document.addEventListener('DOMContentLoaded', function () {
  const calendarEl = document.getElementById('calendarPanel');
  const calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: 'dayGridMonth',
    headerToolbar: {
      left: 'prev,next today',
      center: 'title',
      right: 'dayGridMonth,timeGridWeek,timeGridDay'
    },
    selectable: true,
    select: function (info) {
      const eventName = prompt('Event name:');
      if (eventName) {
        calendar.addEvent({
          title: eventName,
          start: info.startStr,
          end: info.endStr,
          allDay: info.allDay,
          backgroundColor: '#BD6221', // default user color
          extendedProps: { createdBy: 'user' }
        });
      }
      calendar.unselect();
    },
    events: [
      {
        title: 'Admin Event Example',
        start: new Date().toISOString().slice(0, 10),
        backgroundColor: '#777060',
        extendedProps: { createdBy: 'admin' }
      }
    ]
  });

  calendar.render();
});
